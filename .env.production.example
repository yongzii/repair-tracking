APP_NAME="Repair Service Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Replace with the TiDB Cloud endpoint assigned to the production cluster.
DB_HOST=your-tidb-cloud-endpoint
DB_PORT=4000
DB_DATABASE=repairsync_cloud
DB_USERNAME=your-production-database-username
DB_PASSWORD=configure-through-hosting-secrets
# Leave empty: a nonempty DB_URL overrides individual MySQL connection values.
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Replace with the provider-mounted, verified TiDB CA certificate path.
MYSQL_ATTR_SSL_CA=/path/provided/by-host/tidb-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_DEFAULT_COUNTRY=+63

PLATFORM_ADMIN_NAME="Platform Administrator"
PLATFORM_ADMIN_EMAIL=owner@your-domain.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-random-password
REPAIR_SEED_DEMO_DATA=false

REPAIR_TAGLINE="Electronics Repair Service Management"
ADMIN_LOGIN_HINT=""
JOB_ORDER_PREFIX=RSMS

VITE_APP_NAME="${APP_NAME}"
